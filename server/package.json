    "mongoose": "9.10.2",
    "morgan": "1.12.1",
    "nodemailer": "10.0.10",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
