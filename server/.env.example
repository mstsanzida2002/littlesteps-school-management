# Copy to server/.env and fill in. Never commit real secrets.

NODE_ENV=development
PORT=5000

# Always include the database name in the URI path:
#   littlesteps_dev → development (the seed script only runs --reset on *_dev / *_test databases)
#   littlesteps     → production
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/littlesteps_dev?retryWrites=true&w=majority
# Optional in development (API still boots and /api/health reports "disconnected").
MONGODB_URI=mongodb://127.0.0.1:27017/littlesteps_dev

# Comma-separated browser origins allowed for direct (non-proxied) API calls.
CLIENT_ORIGIN=http://localhost:5173

# Number of proxies in front of the app. 0 locally; in production (Vercel rewrite → Render) set to 2
# and verify req.ip resolves to the real client IP before relying on per-IP rate limits.
TRUST_PROXY=0

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Auth ---
# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a different secret per environment; changing it signs everyone out (access tokens only).
JWT_ACCESS_SECRET=
# Access token lifetime (s/m/h/d). The refresh token is an opaque cookie, not a JWT.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# FR-AUTH-06 (optional): when false, POST /api/auth/register returns 404.
SELF_REGISTRATION_ENABLED=false
# bcrypt cost factor (tests use 4).
BCRYPT_ROUNDS=12

# --- Email to guardians (optional; absence + low-attendance only) ---
# Off by default. Providers: smtp (Nodemailer), resend (HTTPS API — use where the host blocks
# outbound SMTP on free plans), console (just logs).
EMAIL_ENABLED=false
EMAIL_PROVIDER=console
# EMAIL_FROM="LittleSteps <no-reply@your-school.edu.bd>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# RESEND_API_KEY=
