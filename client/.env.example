# Copy to client/.env.local. Only VITE_* vars are exposed to browser code — never put secrets here.

VITE_APP_NAME=LittleSteps

# Dev-only: where the Vite dev server proxies /api. Not used in production
# (Vercel rewrites /api/* to Render — see vercel.json). The client never uses an absolute API URL.
VITE_DEV_API_PROXY_TARGET=http://localhost:5000

# Socket.io server origin. Leave EMPTY in development (Vite proxies /socket.io).
# In production (Vercel) set it to the Render API origin, e.g. https://YOUR-RENDER-SERVICE.onrender.com
# — Vercel rewrites cannot proxy WebSockets. The server's CLIENT_ORIGIN must allow the Vercel domain.
VITE_SOCKET_URL=
